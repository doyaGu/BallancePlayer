// Chinese (P.R.C.) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_CHS)
#ifdef _WIN32
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#pragma code_page(936)
#endif //_WIN32

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_CONFIG DIALOG DISCARDABLE  0, 0, 290, 460
STYLE DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION |
    WS_SYSMENU
CAPTION "Ballance Configuration"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Startup",IDC_GROUP_STARTUP,7,5,276,58
    LTEXT           "Log Mode:",IDC_LABEL_LOGMODE,16,21,60,8
    COMBOBOX        IDC_COMBO_LOGMODE,85,18,190,45,CBS_DROPDOWNLIST |
                    WS_VSCROLL | WS_TABSTOP
    CONTROL         "Verbose Logging",IDC_CHECK_VERBOSE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,36,255,10
    CONTROL         "Manual Setup Dialog on Start",IDC_CHECK_MANUALSETUP,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,49,255,10
    GROUPBOX        "Graphics",IDC_GROUP_GRAPHICS,7,68,276,78
    LTEXT           "Driver ID:",IDC_LABEL_DRIVER,16,85,50,8
    EDITTEXT        IDC_CONFIG_EDIT_DRIVER,75,82,45,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "BPP:",IDC_LABEL_BPP,150,85,30,8
    COMBOBOX        IDC_COMBO_BPP,190,82,85,30,CBS_DROPDOWNLIST | WS_VSCROLL |
                    WS_TABSTOP
    LTEXT           "Width:",IDC_LABEL_WIDTH,16,103,50,8
    EDITTEXT        IDC_EDIT_WIDTH,75,100,45,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Height:",IDC_LABEL_HEIGHT,150,103,35,8
    EDITTEXT        IDC_EDIT_HEIGHT,190,100,85,12,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Fullscreen",IDC_CHECK_FULLSCREEN,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,125,255,10
    GROUPBOX        "Window",IDC_GROUP_WINDOW,7,151,276,92
    CONTROL         "Render in Child Window",IDC_CHECK_CHILDWINRENDER,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,166,255,10
    CONTROL         "Borderless Window",IDC_CHECK_BORDERLESS,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,179,255,10
    CONTROL         "Clip Cursor to Window",IDC_CHECK_CLIPCURSOR,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,192,255,10
    CONTROL         "Always Handle Input (Background)",
                    IDC_CHECK_ALWAYSHANDLEINPUT,"Button",BS_AUTOCHECKBOX |
                    WS_TABSTOP,16,205,255,10
    LTEXT           "Pos X:",IDC_LABEL_POSX,16,225,45,8
    EDITTEXT        IDC_EDIT_POSX,75,222,45,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Pos Y:",IDC_LABEL_POSY,150,225,35,8
    EDITTEXT        IDC_EDIT_POSY,190,222,85,12,ES_AUTOHSCROLL | ES_NUMBER
    GROUPBOX        "Game",IDC_GROUP_GAME,7,248,276,126
    LTEXT           "Language:",IDC_LABEL_GAME_LANGUAGE,16,264,60,8
    COMBOBOX        IDC_COMBO_LANG,85,261,190,60,CBS_DROPDOWNLIST |
                    WS_VSCROLL | WS_TABSTOP
    CONTROL         "Skip Opening Animation",IDC_CHECK_SKIPOPENING,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,282,255,10
    CONTROL         "Apply Script Hotfixes",IDC_CHECK_APPLYHOTFIX,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,295,255,10
    CONTROL         "Unlock Framerate",IDC_CHECK_UNLOCKFRAMERATE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,308,255,10
    CONTROL         "Unlock Widescreen (Non-4:3)",IDC_CHECK_UNLOCKWIDESCREEN,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,321,255,10
    CONTROL         "Unlock High Resolution (>1600w)",
                    IDC_CHECK_UNLOCKHIGHRES,"Button",BS_AUTOCHECKBOX |
                    WS_TABSTOP,16,334,255,10
    CONTROL         "Enable In-Game Debug Mode",IDC_CHECK_DEBUG,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,347,255,10
    CONTROL         "Enable In-Game Rookie Mode",IDC_CHECK_ROOKIE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,360,255,10
    GROUPBOX        "Interface",IDC_GROUP_INTERFACE,7,379,276,39
    LTEXT           "Language:",IDC_LABEL_UI_LANGUAGE,16,396,60,8
    COMBOBOX        IDC_COMBO_LANGUAGE,85,393,190,60,CBS_DROPDOWNLIST |
                    WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Defaults",IDC_BUTTON_DEFAULTS,145,435,42,14
    DEFPUSHBUTTON   "OK",IDOK,193,435,42,14
    PUSHBUTTON      "Cancel",IDCANCEL,241,435,42,14
END

