/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_CONFIG DIALOG DISCARDABLE  0, 0, 310, 405
STYLE DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION |
    WS_SYSMENU
CAPTION "Ballance Configuration"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Startup",IDC_GROUP_STARTUP,7,5,296,52
    LTEXT           "Log Mode:",IDC_LABEL_LOGMODE,16,21,70,8
    COMBOBOX        IDC_COMBO_LOGMODE,95,18,208,45,CBS_DROPDOWNLIST |
                    WS_VSCROLL | WS_TABSTOP
    CONTROL         "Verbose Logging",IDC_CHECK_VERBOSE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,34,280,10
    CONTROL         "Manual Setup Dialog on Start",IDC_CHECK_MANUALSETUP,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,46,280,10
    GROUPBOX        "Graphics",IDC_GROUP_GRAPHICS,7,62,296,66
    LTEXT           "Driver ID:",IDC_LABEL_DRIVER,16,78,60,8
    EDITTEXT        IDC_CONFIG_EDIT_DRIVER,85,75,45,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "BPP:",IDC_LABEL_BPP,160,78,35,8
    COMBOBOX        IDC_COMBO_BPP,205,75,98,30,CBS_DROPDOWNLIST | WS_VSCROLL |
                    WS_TABSTOP
    LTEXT           "Width:",IDC_LABEL_WIDTH,16,96,60,8
    EDITTEXT        IDC_EDIT_WIDTH,85,93,45,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Height:",IDC_LABEL_HEIGHT,160,96,40,8
    EDITTEXT        IDC_EDIT_HEIGHT,205,93,98,12,ES_AUTOHSCROLL | ES_NUMBER
    CONTROL         "Fullscreen",IDC_CHECK_FULLSCREEN,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,112,280,10
    GROUPBOX        "Window",IDC_GROUP_WINDOW,7,133,296,80
    CONTROL         "Render in Child Window",IDC_CHECK_CHILDWINRENDER,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,148,280,10
    CONTROL         "Borderless Window",IDC_CHECK_BORDERLESS,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,160,280,10
    CONTROL         "Clip Cursor to Window",IDC_CHECK_CLIPCURSOR,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,172,280,10
    CONTROL         "Always Handle Input (Background)",
                    IDC_CHECK_ALWAYSHANDLEINPUT,"Button",BS_AUTOCHECKBOX |
                    WS_TABSTOP,16,184,280,10
    LTEXT           "Pos X:",IDC_LABEL_POSX,16,199,50,8
    EDITTEXT        IDC_EDIT_POSX,85,196,45,12,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Pos Y:",IDC_LABEL_POSY,160,199,40,8
    EDITTEXT        IDC_EDIT_POSY,205,196,98,12,ES_AUTOHSCROLL | ES_NUMBER
    GROUPBOX        "Game",IDC_GROUP_GAME,7,218,296,112
    LTEXT           "Language:",IDC_LABEL_GAME_LANGUAGE,16,234,70,8
    COMBOBOX        IDC_COMBO_LANG,95,231,208,60,CBS_DROPDOWNLIST |
                    WS_VSCROLL | WS_TABSTOP
    CONTROL         "Skip Opening Animation",IDC_CHECK_SKIPOPENING,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,252,280,10
    CONTROL         "Apply Script Hotfixes",IDC_CHECK_APPLYHOTFIX,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,263,280,10
    CONTROL         "Unlock Framerate",IDC_CHECK_UNLOCKFRAMERATE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,274,280,10
    CONTROL         "Unlock Widescreen (Non-4:3)",IDC_CHECK_UNLOCKWIDESCREEN,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,285,280,10
    CONTROL         "Unlock High Resolution (>1600w)",
                    IDC_CHECK_UNLOCKHIGHRES,"Button",BS_AUTOCHECKBOX |
                    WS_TABSTOP,16,296,280,10
    CONTROL         "Enable In-Game Debug Mode",IDC_CHECK_DEBUG,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,307,280,10
    CONTROL         "Enable In-Game Rookie Mode",IDC_CHECK_ROOKIE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,318,280,10
    GROUPBOX        "Interface",IDC_GROUP_INTERFACE,7,335,296,34
    LTEXT           "Language:",IDC_LABEL_UI_LANGUAGE,16,350,70,8
    COMBOBOX        IDC_COMBO_LANGUAGE,95,347,208,60,CBS_DROPDOWNLIST |
                    WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Defaults",IDC_BUTTON_DEFAULTS,164,384,42,14
    DEFPUSHBUTTON   "OK",IDOK,212,384,42,14
    PUSHBUTTON      "Cancel",IDCANCEL,260,384,42,14
END

